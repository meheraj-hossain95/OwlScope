# -------------------------------------------------------
# OwlScope — Issue Investigator  |  Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Ollama ---
# URL of your Ollama instance.
# For local Ollama:  http://localhost:11434
# For Ngrok tunnel:  https://xxxx-xx-xx-xx-xx.ngrok-free.app
OLLAMA_HOST=your_api_key_here
# The Ollama model to use for generation.
# Examples: qwen2.5-coder:7b  |  llama3  |  codellama
OLLAMA_MODEL=MODEL NAME

# --- GitHub ---
# Optional. Without a token you get 60 requests/hour (public repos only).
# With a Personal Access Token (PAT) you get 5000 requests/hour.
# Create one at: https://github.com/settings/tokens  (no scopes needed for public repos)
GITHUB_TOKEN=

# --- Flask ---
# Change this to a long random string in production.
FLASK_SECRET_KEY=

# --- Cache ---
# Directory where generated reports are stored as JSON files.
# Relative to the OwlScope/ folder.
CACHE_DIR=
